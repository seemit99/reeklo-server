generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model character_parts {
  id                                                                     BigInt              @id @default(autoincrement())
  creator_id                                                             BigInt?
  name                                                                   String              @db.VarChar(100)
  part_type                                                              String              @db.VarChar(20)
  image_url                                                              String              @db.VarChar(500)
  price                                                                  Int                 @default(0)
  is_approved                                                            Boolean             @default(false)
  download_count                                                         Int                 @default(0)
  created_at                                                             DateTime            @default(now()) @db.Timestamp(6)
  pivot_x                                                                Int?
  pivot_y                                                                Int?
  users                                                                  users?              @relation(fields: [creator_id], references: [id], onUpdate: NoAction)
  character_presets_character_presets_accessory_part_idTocharacter_parts character_presets[] @relation("character_presets_accessory_part_idTocharacter_parts")
  character_presets_character_presets_arm_l_part_idTocharacter_parts     character_presets[] @relation("character_presets_arm_l_part_idTocharacter_parts")
  character_presets_character_presets_arm_r_part_idTocharacter_parts     character_presets[] @relation("character_presets_arm_r_part_idTocharacter_parts")
  character_presets_character_presets_body_part_idTocharacter_parts      character_presets[] @relation("character_presets_body_part_idTocharacter_parts")
  character_presets_character_presets_head_part_idTocharacter_parts      character_presets[] @relation("character_presets_head_part_idTocharacter_parts")
  character_presets_character_presets_leg_l_part_idTocharacter_parts     character_presets[] @relation("character_presets_leg_l_part_idTocharacter_parts")
  character_presets_character_presets_leg_r_part_idTocharacter_parts     character_presets[] @relation("character_presets_leg_r_part_idTocharacter_parts")
  user_items                                                             user_items[]

  @@index([is_approved], map: "idx_character_parts_approved")
  @@index([creator_id], map: "idx_character_parts_creator")
  @@index([part_type], map: "idx_character_parts_type")
}

model character_presets {
  id                                                                   BigInt           @id @default(autoincrement())
  user_id                                                              BigInt?          @unique
  head_part_id                                                         BigInt?
  body_part_id                                                         BigInt?
  arm_l_part_id                                                        BigInt?
  arm_r_part_id                                                        BigInt?
  leg_l_part_id                                                        BigInt?
  leg_r_part_id                                                        BigInt?
  accessory_part_id                                                    BigInt?
  updated_at                                                           DateTime         @default(now()) @db.Timestamp(6)
  layer_order                                                          String?          @db.VarChar(120)
  rig_pivots                                                           String?          @db.VarChar(255)
  character_parts_character_presets_accessory_part_idTocharacter_parts character_parts? @relation("character_presets_accessory_part_idTocharacter_parts", fields: [accessory_part_id], references: [id], onUpdate: NoAction)
  character_parts_character_presets_arm_l_part_idTocharacter_parts     character_parts? @relation("character_presets_arm_l_part_idTocharacter_parts", fields: [arm_l_part_id], references: [id], onUpdate: NoAction)
  character_parts_character_presets_arm_r_part_idTocharacter_parts     character_parts? @relation("character_presets_arm_r_part_idTocharacter_parts", fields: [arm_r_part_id], references: [id], onUpdate: NoAction)
  character_parts_character_presets_body_part_idTocharacter_parts      character_parts? @relation("character_presets_body_part_idTocharacter_parts", fields: [body_part_id], references: [id], onUpdate: NoAction)
  character_parts_character_presets_head_part_idTocharacter_parts      character_parts? @relation("character_presets_head_part_idTocharacter_parts", fields: [head_part_id], references: [id], onUpdate: NoAction)
  character_parts_character_presets_leg_l_part_idTocharacter_parts     character_parts? @relation("character_presets_leg_l_part_idTocharacter_parts", fields: [leg_l_part_id], references: [id], onUpdate: NoAction)
  character_parts_character_presets_leg_r_part_idTocharacter_parts     character_parts? @relation("character_presets_leg_r_part_idTocharacter_parts", fields: [leg_r_part_id], references: [id], onUpdate: NoAction)
  users                                                                users?           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model parties {
  id              BigInt   @id @default(autoincrement())
  room_id         BigInt?
  leader_id       BigInt?
  plaza_id        BigInt?
  game            String   @db.VarChar(50)
  title           String   @db.VarChar(100)
  max_members     Int      @default(5)
  current_members Int      @default(1)
  status          String   @default("OPEN") @db.VarChar(20)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  users           users?   @relation(fields: [leader_id], references: [id], onUpdate: NoAction)
  rooms           rooms?   @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([leader_id], map: "idx_parties_leader_id")
  @@index([room_id], map: "idx_parties_room_id")
  @@index([status], map: "idx_parties_status")
}

model guilds {
  id              BigInt              @id @default(autoincrement())
  name            String              @unique @db.VarChar(30)
  tag             String              @unique @db.VarChar(6)
  description     String?             @db.VarChar(200)
  leader_id       BigInt?
  game_type       String              @default("ALL") @db.VarChar(20)
  max_members     Int                 @default(30)
  current_members Int                 @default(1)
  emblem_url      String?             @db.VarChar(500)
  is_public       Boolean             @default(true)
  created_at      DateTime            @default(now()) @db.Timestamp(6)
  leader          users?              @relation("guild_leader", fields: [leader_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  members         guild_members[]
  invitations     guild_invitations[]

  @@index([game_type], map: "idx_guilds_game_type")
  @@index([leader_id], map: "idx_guilds_leader_id")
}

model guild_members {
  id        BigInt   @id @default(autoincrement())
  guild_id  BigInt?
  user_id   BigInt?
  role      String   @default("MEMBER") @db.VarChar(20)
  joined_at DateTime @default(now()) @db.Timestamp(6)
  guild     guilds?  @relation(fields: [guild_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      users?   @relation("guild_membership", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([guild_id, user_id])
}

model guild_invitations {
  id         BigInt   @id @default(autoincrement())
  guild_id   BigInt?
  inviter_id BigInt?
  invitee_id BigInt?
  status     String   @default("PENDING") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(6)
  guild      guilds?  @relation(fields: [guild_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model plazas {
  id            BigInt       @id @default(autoincrement())
  name          String       @db.VarChar(100)
  game_type     String       @default("ALL") @db.VarChar(50)
  max_users     Int          @default(100)
  current_users Int          @default(0)
  map_data      Json?
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  owner_id      BigInt?
  plaza_type    String       @default("PUBLIC") @db.VarChar(20)
  use_yn        String       @default("Y") @db.Char(1)
  category_code String       @default("GENERAL") @db.VarChar(30)
  description   String?      @db.VarChar(300)
  is_private    Boolean      @default(false)
  password_hash String?      @db.VarChar(100)
  owner         users?       @relation("plaza_owner", fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rooms         rooms[]
  plaza_tags    plaza_tags[]

  @@index([owner_id], map: "idx_plazas_owner")
  @@index([category_code, use_yn], map: "idx_plazas_search")
}

model email_codes {
  id         BigInt   @id @default(autoincrement())
  email      String   @db.VarChar(100)
  code       String   @db.VarChar(10)
  purpose    String   @db.VarChar(20)
  expires_at DateTime @db.Timestamp(6)
  verified   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@index([email, purpose], map: "idx_email_codes_lookup")
}

model friendships {
  id           BigInt   @id @default(autoincrement())
  requester_id BigInt?
  addressee_id BigInt?
  status       String   @default("PENDING") @db.VarChar(20)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @db.Timestamp(6)
  requester    users?   @relation("friend_requester", fields: [requester_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  addressee    users?   @relation("friend_addressee", fields: [addressee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requester_id, addressee_id])
  @@index([addressee_id, status], map: "idx_friendships_addressee")
  @@index([requester_id, status], map: "idx_friendships_requester")
}

model user_settings {
  user_id    BigInt   @id
  settings   Json     @default("{}")
  updated_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model reports {
  id               BigInt   @id @default(autoincrement())
  reporter_id      BigInt
  reported_user_id BigInt
  reason           String   @db.VarChar(30)
  detail           String?  @db.VarChar(500)
  context          String?  @db.VarChar(50)
  status           String   @default("OPEN") @db.VarChar(20)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  reporter         users    @relation("report_reporter", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reported         users    @relation("report_target", fields: [reported_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([reported_user_id], map: "idx_reports_reported")
  @@index([status], map: "idx_reports_status")
}

model chat_messages {
  id                BigInt    @id @default(autoincrement())
  message_id        String    @unique @default(uuid()) @db.Uuid
  sender_id         BigInt?
  recipient_id      BigInt?
  sender_nickname   String    @db.VarChar(50)
  channel_type      String    @db.VarChar(20)
  channel_id        BigInt?
  content           String    @db.Text
  metadata          Json      @default("{}")
  moderation_status String    @default("NORMAL") @db.VarChar(20)
  use_yn            String    @default("Y") @db.Char(1)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  edited_at         DateTime? @db.Timestamp(6)
  deleted_at        DateTime? @db.Timestamp(6)
  sender            users?    @relation("chat_message_sender", fields: [sender_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recipient         users?    @relation("chat_message_recipient", fields: [recipient_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([channel_type, channel_id, use_yn, created_at], map: "idx_chat_messages_channel")
  @@index([sender_id, created_at], map: "idx_chat_messages_sender")
  @@index([recipient_id, created_at], map: "idx_chat_messages_recipient")
  @@index([moderation_status, created_at], map: "idx_chat_messages_moderation")
}

model user_blocks {
  id              BigInt   @id @default(autoincrement())
  user_id         BigInt
  blocked_user_id BigInt
  created_at      DateTime @default(now()) @db.Timestamp(6)
  blocker         users    @relation("block_owner", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blocked         users    @relation("block_target", fields: [blocked_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, blocked_user_id])
}

model rooms {
  id            BigInt      @id @default(autoincrement())
  plaza_id      BigInt?
  owner_id      BigInt?
  title         String      @db.VarChar(100)
  max_users     Int         @default(20)
  current_users Int         @default(0)
  is_private    Boolean     @default(false)
  password      String?     @db.VarChar(100)
  room_type     String      @default("GENERAL") @db.VarChar(20)
  category_code String      @default("GENERAL") @db.VarChar(30)
  description   String?     @db.VarChar(300)
  use_yn        String      @default("Y") @db.Char(1)
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  parties       parties[]
  users         users?      @relation(fields: [owner_id], references: [id], onUpdate: NoAction)
  plazas        plazas?     @relation(fields: [plaza_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  room_tags     room_tags[]

  @@index([owner_id], map: "idx_rooms_owner_id")
  @@index([plaza_id], map: "idx_rooms_plaza_id")
  @@index([plaza_id, category_code, use_yn], map: "idx_rooms_search")
}

model room_categories {
  code          String   @id @db.VarChar(30)
  name          String   @db.VarChar(50)
  display_order Int      @default(0)
  use_yn        String   @default("Y") @db.Char(1)
  created_at    DateTime @default(now()) @db.Timestamp(6)
}

model tags {
  id         BigInt       @id @default(autoincrement())
  name       String       @unique @db.VarChar(20)
  use_yn     String       @default("Y") @db.Char(1)
  created_at DateTime     @default(now()) @db.Timestamp(6)
  room_tags  room_tags[]
  plaza_tags plaza_tags[]
}

model plaza_tags {
  plaza_id   BigInt
  tag_id     BigInt
  use_yn     String   @default("Y") @db.Char(1)
  created_at DateTime @default(now()) @db.Timestamp(6)
  plaza      plazas   @relation(fields: [plaza_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tag        tags     @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([plaza_id, tag_id])
  @@index([tag_id, use_yn], map: "idx_plaza_tags_search")
}

model room_tags {
  room_id    BigInt
  tag_id     BigInt
  use_yn     String   @default("Y") @db.Char(1)
  created_at DateTime @default(now()) @db.Timestamp(6)
  room       rooms    @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tag        tags     @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([room_id, tag_id])
  @@index([tag_id, use_yn], map: "idx_room_tags_search")
}

model user_items {
  id              BigInt           @id @default(autoincrement())
  user_id         BigInt?
  part_id         BigInt?
  purchased_at    DateTime         @default(now()) @db.Timestamp(6)
  character_parts character_parts? @relation(fields: [part_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, part_id])
  @@index([part_id], map: "idx_user_items_part_id")
  @@index([user_id], map: "idx_user_items_user_id")
}

model users {
  id                     BigInt             @id @default(autoincrement())
  username               String             @unique @db.VarChar(50)
  email                  String             @unique @db.VarChar(100)
  password               String             @db.VarChar(255)
  nickname               String             @db.VarChar(50)
  coin                   Int                @default(0)
  bio                    String?            @db.VarChar(200)
  main_game              String?            @db.VarChar(50)
  last_check_in          DateTime?          @db.Date
  attendance_streak      Int                @default(0)
  session_version        Int                @default(0)
  privacy_consent_yn     String             @default("N") @db.Char(1)
  privacy_consent_at     DateTime?          @db.Timestamp(6)
  privacy_policy_version String?            @db.VarChar(20)
  role                   String             @default("USER") @db.VarChar(20)
  use_yn                 String             @default("Y") @db.Char(1)
  last_plaza_id          BigInt?
  created_at             DateTime           @default(now()) @db.Timestamp(6)
  character_parts        character_parts[]
  character_presets      character_presets?
  parties                parties[]
  rooms                  rooms[]
  user_items             user_items[]
  owned_plazas           plazas[]           @relation("plaza_owner")
  friend_sent            friendships[]      @relation("friend_requester")
  friend_received        friendships[]      @relation("friend_addressee")
  user_settings          user_settings?
  blocks_made            user_blocks[]      @relation("block_owner")
  blocks_received        user_blocks[]      @relation("block_target")
  reports_made           reports[]          @relation("report_reporter")
  reports_received       reports[]          @relation("report_target")
  chat_messages_sent     chat_messages[]    @relation("chat_message_sender")
  chat_messages_received chat_messages[]    @relation("chat_message_recipient")
  guilds_led             guilds[]           @relation("guild_leader")
  guild_memberships      guild_members[]    @relation("guild_membership")
  password_recovery_questions password_recovery_questions[]
  admin_audit_logs       admin_audit_logs[]

  @@index([email], map: "idx_users_email")
  @@index([username], map: "idx_users_username")
}

model admin_audit_logs {
  id            BigInt   @id @default(autoincrement())
  actor_user_id BigInt
  action        String   @db.VarChar(50)
  target_type   String?  @db.VarChar(50)
  target_id     String?  @db.VarChar(100)
  metadata      Json     @default("{}")
  use_yn        String   @default("Y") @db.Char(1)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  actor         users    @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([actor_user_id, created_at], map: "idx_admin_audit_logs_actor_created")
}

model password_recovery_questions {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt
  question     String    @db.VarChar(100)
  answer_hash  String    @db.VarChar(255)
  failed_count Int       @default(0)
  locked_until DateTime? @db.Timestamp(6)
  use_yn       String    @default("Y") @db.Char(1)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @db.Timestamp(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([user_id], map: "idx_password_recovery_questions_user")
}
